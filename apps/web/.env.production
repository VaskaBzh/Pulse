# Production build config for apps/web (loaded by `vite build`, mode=production).
#
# DO NOT hardcode VITE_API_URL here — prod runs on Vercel, and the value must
# point at the deployed backend, not localhost. Set it in Vercel instead; real
# env vars take precedence over .env files at `vite build`:
#
#   vercel env add VITE_API_URL production
#   # value: https://<pulse-api>.up.railway.app/api
#
# The API is not deployed to Railway yet (see ROADMAP Фаза 1.6 / 3.2). Until the
# backend URL exists and the Vercel env var is set, production builds will have
# VITE_API_URL undefined and API calls will fail.
#
# Optional client log level (defaults to `warn` in production builds).
# VITE_LOG_LEVEL=warn
