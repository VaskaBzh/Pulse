      "get": {
        "operationId": "AnalyticsController_getFunnel",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FunnelStepDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "analytics"
        ]
      }
    },
    "/analytics/retention": {
      "get": {
        "operationId": "AnalyticsController_getRetention",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RetentionRowDto"
                  }
                }
              }
            }
