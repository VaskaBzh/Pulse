  "info": {
    "title": "Pulse API",
    "description": "Analytics dashboard backend API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "DailyMetricDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "revenue": {
            "type": "number"
          },
          "profit": {
            "type": "number"
          },
          "orders": {
            "type": "number"
          },
          "users": {
            "type": "number"
          },
          "sessions": {
            "type": "number"
          },
          "conversionRate": {
            "type": "number"
          },
          "avgOrderValue": {
            "type": "number"
          }
        },
        "required": [
          "date",
          "revenue",
          "profit",
          "orders",
          "users",
          "sessions",
          "conversionRate",
          "avgOrderValue"
        ]
      },
      "TrafficSourceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value",
          "color"
        ]
      },
      "PaginatedOrdersDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "customer": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "completed",
                    "pending",
                    "cancelled",
                    "refunded"
                  ]
                },
                "date": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "customer",
                "email",
                "product",
                "amount",
                "status",
                "date",
                "country"
              ]
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "number"
              },
              "limit": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "totalPages": {
                "type": "number"
              }
            },
            "required": [
              "page",
              "limit",
              "total",
              "totalPages"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "revenue": {
            "type": "number"
          },
          "orders": {
            "type": "number"
          },
          "growth": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "revenue",
          "orders",
          "growth"
        ]
      },
      "CustomerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "segment": {
            "type": "string",
            "enum": [
              "Enterprise",
              "Pro",
              "Starter"
            ]
          },
          "ltv": {
            "type": "number"
          },
          "joinDate": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "orders": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "segment",
          "ltv",
          "joinDate",
          "country",
          "orders"
        ]
      },
      "FunnelStepDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "conversionRate": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "value",
          "conversionRate"
        ]
      },
      "RetentionRowDto": {
        "type": "object",
        "properties": {
          "cohort": {
            "type": "string"
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "cohort",
          "weeks"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "uptime": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "timestamp",
          "uptime"
        ]
      }
    }
  }
}
